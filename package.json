{
  "name": "raidbots-legion",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador de DPS local estilo Raidbots para World of Warcraft: Legion 7.3.5",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @rbl/server",
    "dev:web": "npm run dev --workspace @rbl/web",
    "build": "npm run build --workspace @rbl/web",
    "start": "npm run start --workspace @rbl/server",
    "setup:simc": "bash scripts/setup-simc.sh",
    "build:simc-windows": "bash scripts/build-simc-windows.sh",
    "build:itemdb": "node scripts/build-item-db.mjs",
    "build:patchdb": "node scripts/build-patch-db.mjs",
    "build:enhancements": "node scripts/build-enhancements-db.mjs",
    "typecheck": "tsc --noEmit -p packages/server && tsc --noEmit -p packages/web",
    "check:simc": "node scripts/check-simc.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "test:addon": "lua5.4 addon/test/run.lua --check",
    "test:pawn": "node --test --experimental-strip-types scripts/test-pawn.mjs",
    "test:upgrades": "node --test --experimental-strip-types scripts/test-upgrades.mjs",
    "test": "npm run test:pawn && npm run test:upgrades && npm run test:itemdb && npm run test:custom && npm run test:import && npm run test:loot && npm run test:addon",
    "test:itemdb": "tsx --test scripts/test-itemdb.mjs",
    "test:custom": "tsx --test scripts/test-custom-items.mjs",
    "test:import": "tsx --test scripts/test-import.mjs",
    "test:loot": "tsx --test scripts/test-loot.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
